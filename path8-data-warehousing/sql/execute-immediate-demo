-- -----------------------------------------------------------------------------
-- EXEMPLO BASE: padrão completo dos slides
-- Query dinâmica parametrizada por nome de tabela e status filter
-- -----------------------------------------------------------------------------

-- Passo 1: Declarar variáveis de input (os "knobs and levers")
DECLARE OR REPLACE table_name    STRING DEFAULT "bronze.orders";
DECLARE OR REPLACE status_filter STRING DEFAULT "F";   -- F = Finalized

-- Passo 2: Construir a query string com placeholders (?)
-- Os (?) serão substituídos pelos valores do USING, pela mesma ordem
DECLARE OR REPLACE sqlStr STRING DEFAULT
  "SELECT o_orderpriority, COUNT(*) AS num_orders " ||
  "FROM (?) WHERE o_orderstatus = (?) " ||
  "GROUP BY o_orderpriority";

-- Passo 3: Executar dinamicamente
-- USING injeta os valores nos (?) de forma segura (parameter binding)
EXECUTE IMMEDIATE sqlStr
  USING table_name, status_filter;


-- -----------------------------------------------------------------------------
-- EXEMPLO 2: mudar os parâmetros para um contexto diferente
-- Mesmo script, tabela diferente, status diferente
-- -----------------------------------------------------------------------------

-- Sobrescrever as variáveis para um novo contexto
SET VAR table_name    = "bronze.orders";
SET VAR status_filter = "O";   -- O = Open orders

-- Reutilizar exatamente o mesmo sqlStr — sem tocar na lógica
EXECUTE IMMEDIATE sqlStr
  USING table_name, status_filter;


-- -----------------------------------------------------------------------------
-- EXEMPLO 3: query mais complexa — filtro dinâmico com agregação
-- Útil para dashboards ou relatórios parametrizados
-- -----------------------------------------------------------------------------

DECLARE OR REPLACE region_filter STRING DEFAULT "EUROPE";

DECLARE OR REPLACE sqlStr2 STRING DEFAULT
  "SELECT n.n_name AS nation, COUNT(*) AS order_count, SUM(o.o_totalprice) AS revenue " ||
  "FROM (?) o " ||
  "JOIN bronze.customer c  ON o.o_custkey  = c.c_custkey " ||
  "JOIN bronze.nation   n  ON c.c_nationkey = n.n_nationkey " ||
  "JOIN bronze.region   r  ON n.n_regionkey = r.r_regionkey " ||
  "WHERE r.r_name = (?) " ||
  "GROUP BY n.n_name " ||
  "ORDER BY revenue DESC";

EXECUTE IMMEDIATE sqlStr2
  USING table_name, region_filter;


-- =============================================================================
-- Resumo do padrão:
--
--   1. DECLARE OR REPLACE variavel TIPO DEFAULT valor;   ← inputs
--   2. DECLARE OR REPLACE sqlStr STRING DEFAULT "..." || variavel || "...";
--      -- usa (?) como placeholders para parameter binding seguro
--   3. EXECUTE IMMEDIATE sqlStr USING var1, var2, ...;   ← execução
--
-- Casos de uso típicos:
--   → Nome de tabela variável (bronze / silver / gold)
--   → Filtros dinâmicos entre job runs
--   → Mesmo script em dev / staging / prod
--   → Dashboards com input do utilizador
--   → Batch processing sobre múltiplas tabelas
--
-- ⚠️  Sempre valida os valores das variáveis antes de injetar
-- ⚠️  Prefere USING a concatenar valores directamente na string
-- =============================================================================

