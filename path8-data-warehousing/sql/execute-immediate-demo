--
--   Cell 24: variável no FROM e no WHERE  → tabela e filtro dinâmicos
--   Cell 26: variável no ORDER BY         → coluna de ordenação dinâmica
--   Cell 28: CASE WHEN na string          → cláusula WHERE opcional
--
-- Qualquer parte da query pode ser dinâmica:
--   FROM, WHERE, ORDER BY, GROUP BY, SELECT columns, JOIN conditions
--
-- SET VARIABLE → sobrescreve um DEFAULT declarado anteriormente
-- CASE WHEN dentro da string → lógica condicional na construção da query
