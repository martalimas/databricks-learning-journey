-- -----------------------------------------------------------------------------
-- CELL 24: Padrão base — variáveis de input + query dinâmica
-- Objectivo: contar orders por prioridade, filtradas por status
--
-- Nota do lab: aqui o sqlStr concatena os valores das variáveis
-- directamente na string (via ||). O USING serve para parameter binding
-- mas neste exemplo específico os valores já estão inline na string.
-- -----------------------------------------------------------------------------
DECLARE OR REPLACE table_name    STRING DEFAULT "bronze.orders";
DECLARE OR REPLACE status_filter STRING DEFAULT "F";   -- F = Finalized

DECLARE OR REPLACE sqlStr STRING DEFAULT
  "SELECT o_orderpriority, COUNT(*) AS num_orders FROM " || table_name ||
  " WHERE o_orderstatus = '" || status_filter || "' GROUP BY o_orderpriority";

-- Executar dinamicamente
EXECUTE IMMEDIATE sqlStr USING table_name, status_filter;

-- Resultado esperado:
--   5-LOW          → 730,923
--   3-MEDIUM       → 730,832
--   1-URGENT       → 731,447
--   4-NOT SPECIFIED → 731,011
--   2-HIGH         → 730,288


-- -----------------------------------------------------------------------------
-- CELL 26 — Iteration 1: Dynamic Column Name and ORDER BY Clause
-- Objectivo: parametrizar também a coluna de ordenação
-- Demonstra que QUALQUER parte da query pode ser dinâmica — incluindo
-- nomes de colunas e cláusulas ORDER BY
-- -----------------------------------------------------------------------------
DECLARE OR REPLACE table_name    STRING DEFAULT "bronze.orders";
DECLARE OR REPLACE order_column  STRING DEFAULT "avg_price";

DECLARE OR REPLACE sqlStr STRING DEFAULT
  "SELECT o_orderpriority, AVG(o_totalprice) AS avg_price FROM " || table_name ||
  " GROUP BY o_orderpriority ORDER BY " || order_column || " DESC";

EXECUTE IMMEDIATE sqlStr USING table_name, order_column;

-- Resultado esperado (ordenado por avg_price DESC):
--   2-HIGH          → 151,271.60
--   1-URGENT        → 151,159.55
--   5-LOW           → 151,114.18
--   4-NOT SPECIFIED → 151,089.99
--   3-MEDIUM        → 150,990.79


-- -----------------------------------------------------------------------------
-- CELL 28 — Iteration 2: Conditional WHERE Clause (filtro opcional)
-- Objectivo: adicionar ou omitir o WHERE consoante a variável tem valor ou não
--
-- ⭐ Padrão avançado: CASE WHEN dentro da string para lógica condicional
--    - Se region_filter IS NOT NULL → adiciona o WHERE
--    - Se region_filter IS NULL     → omite o WHERE (devolve todas as regiões)
-- -----------------------------------------------------------------------------

-- Com filtro activo: SET VARIABLE sobrescreve o DEFAULT NULL
DECLARE OR REPLACE region_filter STRING DEFAULT NULL;
SET VARIABLE region_filter = "EUROPE";

DECLARE OR REPLACE sqlStr STRING DEFAULT
  "SELECT r.r_name, COUNT(*) AS num_customers " ||
  "FROM bronze.customer c " ||
  "JOIN bronze.nation n ON c.c_nationkey = n.n_nationkey " ||
  "JOIN bronze.region r ON n.n_regionkey = r.r_regionkey " ||
  CASE WHEN region_filter IS NOT NULL
    THEN "WHERE r.r_name = '" || region_filter || "' "
    ELSE ""
  END ||
  "GROUP BY r.r_name";

EXECUTE IMMEDIATE sqlStr USING region_filter;
-- Resultado: EUROPE → 150,306 customers


-- Sem filtro: comentar o SET VARIABLE — region_filter fica NULL
-- O CASE devolve "" → o WHERE é omitido → todas as regiões aparecem
DECLARE OR REPLACE region_filter STRING DEFAULT NULL;
-- SET VARIABLE region_filter = "EUROPE";   ← comentado = sem filtro

DECLARE OR REPLACE sqlStr STRING DEFAULT
  "SELECT r.r_name, COUNT(*) AS num_customers " ||
  "FROM bronze.customer c " ||
  "JOIN bronze.nation n ON c.c_nationkey = n.n_nationkey " ||
  "JOIN bronze.region r ON n.n_regionkey = r.r_regionkey " ||
  CASE WHEN region_filter IS NOT NULL
    THEN "WHERE r.r_name = '" || region_filter || "' "
    ELSE ""
  END ||
  "GROUP BY r.r_name";

EXECUTE IMMEDIATE sqlStr USING region_filter;
-- Resultado (todas as regiões):
--   ASIA        → 150,409
--   EUROPE      → 150,306
--   AMERICA     → 149,877
--   AFRICA      → 149,175
--   MIDDLE EAST → 150,233


